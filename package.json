{
  "name": "crdg-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "db:push": "node scripts/db-push.mjs",
    "worker": "npm run start -w apps/worker",
    "worker:once": "npm run start:once -w apps/worker",
    "wp-sync": "npm run start -w apps/wp-sync",
    "dashboard": "npm run dev -w apps/dashboard",
    "dev": "node scripts/dev-launcher.mjs",
    "start:all": "node scripts/dev-launcher.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.20.0"
  }
}
