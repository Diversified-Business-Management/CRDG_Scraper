# Copy to .env and fill in. The real .env is gitignored.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres?sslmode=require

# WordPress (Houzez)
WP_BASE_URL=https://staging.example.com
WP_USERNAME=admin@example.com
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_BUDGET_USD_PER_RUN=40
ANTHROPIC_BUDGET_USD_PER_DAY=80

# Operational
NODE_ENV=development
LOG_LEVEL=info
DRY_RUN_WP=false
RUN_LIVE_SCRAPE=false

# Fly (only used in deploy)
FLY_ORG=your-org
FLY_REGION=mia
