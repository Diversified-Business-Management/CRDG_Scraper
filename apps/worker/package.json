{
  "name": "@crdg/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/main.ts",
    "start:once": "tsx src/main.ts --once",
    "scrape": "tsx src/cli.ts scrape",
    "scrape:source": "tsx src/cli.ts scrape --source",
    "test": "vitest run"
  },
  "dependencies": {
    "@crdg/core": "*",
    "@crdg/adapters": "*",
    "@crdg/ai": "*",
    "node-cron": "^3.0.3",
    "p-limit": "^6.1.0",
    "p-queue": "^8.0.1",
    "yargs": "^17.7.2",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "@types/yargs": "^17.0.33",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
